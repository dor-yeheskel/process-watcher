{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "process-watcher-email-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "vars": {
    "FROM_EMAIL": "Process Watcher <noreply@example.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "process-watcher-email",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}